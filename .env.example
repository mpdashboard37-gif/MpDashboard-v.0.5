PORT=3000
NODE_ENV=development
DATABASE_MODE=sqlite
# Server-side PostgreSQL connection URL; required only when DATABASE_MODE=postgresql.
DATABASE_URL=
# PostgreSQL TLS certificate verification; production requires true.
DATABASE_SSL=true
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
SESSION_SECRET=replace-with-long-random-secret
ADMIN_INITIAL_PASSWORD=replace-with-strong-admin-password
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ZAPIER_WEBHOOK_URL=
CORS_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# The reset page is the login screen; the app shows the password-reset form when a valid token is present.
# For password-reset emails, configure a working SMTP/relay and a valid FROM address.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=crm@example.com
# EMAIL_PASSWORD=replace-with-a-real-app-password
# EMAIL_FROM=crm@example.com
PASSWORD_RESET_BASE_URL=http://localhost:3000/login.html
