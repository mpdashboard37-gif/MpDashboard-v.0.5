{
    "name": "mpdashboard-crm",
    "version": "1.0.0",
    "description": "MP Dashboard CRM application",
    "main": "server.js",
    "private": true,
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "start": "node server.js",
        "dev": "node server.js",
        "check": "node --check server.js",
        "check:database": "node database/adapter-check.js",
        "check:postgres-adapter": "node --test database/*.test.js",
        "check:security": "node --test security-regression.test.js",
        "test:lead-import": "node --test services/lead-import.test.js",
        "test:lead-assignment": "node --test lead-assignment.test.js",
        "check:staging-e2e": "node --test staging-e2e.test.js",
        "check:backup-restore": "node --test database/backup-restore.test.js",
        "check:integrations": "node --check integrations/zapier.js",
        "backup:sqlite": "node database/backup-restore.js backup",
        "restore:sqlite": "node database/backup-restore.js restore",
        "migrate:postgres": "node migrate-sqlite-to-postgres.js",
        "migrate:mysql": "node migrate-sqlite-to-mysql.js"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.22.3",
        "express-rate-limit": "^8.7.0",
        "express-session": "^1.19.0",
        "helmet": "^7.2.0",
        "morgan": "^1.10.0",
        "mysql2": "^3.24.4",
        "nodemailer": "^10.1.0",
        "pdfkit": "^0.20.2",
        "pg": "8.23.0",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    },
    "devDependencies": {
        "jsdom": "^30.1.2",
        "playwright": "^1.64.0"
    }
}
